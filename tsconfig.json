{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "types",
        "rootDir": "js",
        "strict": true,
        "removeComments": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@/*": ["./js/*"]
        }
    },
    "exclude": ["types"],
    "include": [
        "js/types.ts"
    ]
}
